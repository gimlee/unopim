APP_NAME=UnoPim
APP_ENV=local
APP_KEY=base64:KYjd+rSTlSuhPY29PI0QYL+7P1AcVX1ecLtZikJh5go=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_ADMIN_URL=admin

# Initial admin (used by AdminsTableSeeder on first boot only).
# Leave blank to auto-generate a random password and write it to
# storage/app/admin-credentials.txt — read it once, then delete.
# Existing admin rows are NEVER overwritten on re-seed.
INSTALLER_ADMIN_EMAIL=admin@example.com
INSTALLER_ADMIN_PASSWORD=admin123

# Comma-separated list of upstream proxy IPs (or CIDRs) allowed to set
# X-Forwarded-* headers. Use '*' only if your edge already strips these
# headers from the public internet. Defaults to '127.0.0.1' when unset.
TRUSTED_PROXIES=127.0.0.1

# Optional extra hostnames that should be accepted in the Host header
# in addition to APP_URL (comma-separated, no scheme). Subdomains of
# APP_URL are accepted automatically.
TRUSTED_HOSTS=

# CORS for api/* and sanctum/csrf-cookie. Both default to '*' when unset
# (any method / any origin). Restrict origins in production, comma-separated
# with scheme (e.g. https://app.example.com). See config/cors.php.
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_ORIGINS=*

APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_CURRENCY=USD

# Product Info Management service and its inbound UnoPIM REST client.
PRODUCT_INFO_MANAGEMENT_BASE_URL=http://127.0.0.1:8020
PRODUCT_INFO_MANAGEMENT_API_TOKEN=pim-unopim-local-token
PRODUCT_INFO_MANAGEMENT_TIMEOUT=300
PIM_UNOPIM_CLIENT_ID=16881688-0000-4000-8000-000000000001
PIM_UNOPIM_CLIENT_SECRET=pim-local-client-secret
PIM_UNOPIM_USERNAME=pim-api@local.test
PIM_UNOPIM_PASSWORD=pim-local-api-password

# Master switch for admin notifications. Defaults to true when unset.
NOTIFICATIONS_ENABLED=true

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unopim
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PREFIX=

BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=

ADMIN_MAIL_ADDRESS=
ADMIN_MAIL_NAME=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

QUEUE_CONNECTION=database

ELASTICSEARCH_ENABLED=
ELASTICSEARCH_CONNECTION=
ELASTICSEARCH_HOST=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_INDEX_PREFIX=

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=3600
# REST API requests allowed per minute per client (config/api.php).
REST_API_RATE_LIMIT=120

IMPORT_BATCH_SIZE=1000
IMPORT_BULK_CHUNK_SIZE=500
IMPORT_DEFERRED_INDEXING=false
COMPLETENESS_QUEUE=completeness

MICROSOFT_SSO_ENABLED=false
MICROSOFT_SSO_TENANT=
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
DEBUGBAR_ENABLED=false

FRANKFURTER_URL=https://api.frankfurter.dev/v2/rates
EXCHANGE_RATE_UPDATE_HOURS=3
EXCHANGE_RATE_CURRENCIES=USD,MYR,THB
EXCHANGE_RATE_CA_BUNDLE=
